{
  "name": "orangehrm-automation",
  "version": "1.0.0",
  "description": "Playwright TypeScript enterprise automation framework for OrangeHRM — 9-level POM with self-healing, AI agents, and GitHub Pages reporting",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "test:sanity": "npx playwright test --grep @sanity",
    "test:pim": "npx playwright test --grep @pim",
    "test:admin": "npx playwright test --grep @admin",
    "test:leave": "npx playwright test --grep @leave",
    "test:login": "npx playwright test --grep @login",
    "test:critical": "npx playwright test --grep @critical",
    "report": "npx playwright show-report",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "smart-report:serve": "npx playwright-smart-reporter-serve smart-report.html",
    "smart-report:gates": "npx playwright-smart-reporter gate --min-pass-rate 90 --max-flaky-rate 10",
    "smart-report:merge-history": "npx playwright-smart-reporter-merge-history shard*/test-history.json -o test-history.json --max-runs 20",
    "setup": "npx playwright install --with-deps chromium"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "pom",
    "orangehrm",
    "self-healing"
  ],
  "author": "qtpsudhakarproducts",
  "license": "MIT",
  "devDependencies": {
    "@faker-js/faker": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "csv-parse": "^5.5.6",
    "monocart-reporter": "^2.10.0",
    "playwright-smart-reporter": "^1.3.1",
    "typescript": "^5.7.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "ollama": "^0.6.3"
  }
}
