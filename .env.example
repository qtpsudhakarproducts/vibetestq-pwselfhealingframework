# Local credentials — loaded automatically by Playwright at runtime.
# This file is gitignored. Never commit it.
# Copy .env.example to .env and fill in your values.

BASE_URL=https://opensource-demo.orangehrmlive.com

ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

ESS_USERNAME=Admin
ESS_PASSWORD=admin123

# Uncomment to enable self-healing locally:
ENABLE_RUNTIME_HEALING=true
# HEAL_LLM_PROVIDER=openai
# HEAL_LLM_API_KEY=sk-...

HEAL_LLM_PROVIDER=ollama-cloud
OLLAMA_CLOUD_API_KEY=testkey
OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_CLOUD_MODEL=gemma3:4b