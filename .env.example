# .env.example — commit this file, not .env
# Copy to .env and fill in your values before running tests locally.
# In CI, set these as pipeline environment variables / secrets instead.

BASE_URL=https://opensource-demo.orangehrmlive.com

ADMIN_USERNAME=
ADMIN_PASSWORD=

ESS_USERNAME=
ESS_PASSWORD=

# Optional — self-healing via LLM (disabled by default)
# ENABLE_RUNTIME_HEALING=true
# HEAL_LLM_PROVIDER=openai          # openai | anthropic | gemini
# HEAL_LLM_API_KEY=
# HEAL_LLM_MODEL=                   # optional — defaults to provider's recommended model
# HEAL_MAX_CALLS=10
# HEAL_MAX_CONSECUTIVE_FAILURES=3
#
# Dry-run mode: log which locators would trigger healing without making LLM calls.
# Run locally to discover fragile selectors before enabling full healing in CI.
# HEAL_DRY_RUN=true
#
# Parallel workers: increase for a dedicated (non-shared) OrangeHRM environment.
# Default is 1 — the shared demo site requires sequential execution.
# PLAYWRIGHT_WORKERS=4
